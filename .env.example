# Copy to .env and fill in. Never commit .env. All keys are read by
# src/jarvis/config.py via pydantic-settings; nothing else touches os.environ.

# --- Runtime -----------------------------------------------------------------
JARVIS_MODE=cloud                 # cloud | local
JARVIS_WAKE_WORD=hey jarvis
JARVIS_HOTKEY=ctrl+alt+j
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=./data            # SQLite and Chroma
JARVIS_MODELS_DIR=./models        # ONNX models from scripts/download_models.py

# --- LLM ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
JARVIS_LLM_MODEL=claude-sonnet-5-5
JARVIS_VISION_MODEL=claude-sonnet-5-5

# --- Speech ------------------------------------------------------------------
JARVIS_STT_MODEL=small            # faster-whisper size: tiny|base|small|medium|large-v3
JARVIS_TTS_VOICE=en-GB-RyanNeural # edge-tts voice id
JARVIS_LOCAL_LLM_MODEL=models/llama.gguf
JARVIS_LOCAL_STT_MODEL=models/ggml-base.bin
JARVIS_LOCAL_TTS_MODEL=models/piper-voice.onnx

# --- Integrations (leave empty to use the stub provider) ---------------------
GOOGLE_CLIENT_SECRETS_FILE=       # OAuth client JSON for Gmail + Calendar
MS_CLIENT_ID=                     # Azure app registration for Outlook + Teams
MS_TENANT_ID=common
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Proactive ---------------------------------------------------------------
JARVIS_ROUTINES_DIR=./routines   # YAML routine files, see routines/morning.yaml
JARVIS_PROACTIVE_POLL_SECONDS=60 # how often triggers (calendar, battery...) are checked

# --- Memory ------------------------------------------------------------------
JARVIS_MEMORY_RECENT_TURNS=10    # user/assistant exchanges recalled verbatim
JARVIS_MEMORY_SEMANTIC_HITS=5    # similar past turns/notes recalled from ChromaDB

# --- Agent -------------------------------------------------------------------
JARVIS_CONFIRM_DESTRUCTIVE=true   # false = trusted mode: never ask before side-effecting tools
JARVIS_SHELL_ALLOWLIST=git,ls,dir,cat,type,python,uv,pip,pytest,ruff,mypy,npm,npx,node,cargo,where,which
JARVIS_SHELL_TIMEOUT_SECONDS=30
JARVIS_SHELL_WORKING_ROOT=        # commands may only run under this directory; empty = your home
