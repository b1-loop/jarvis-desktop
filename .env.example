# Copy to .env and fill in. Never commit .env. All keys are read by
# src/jarvis/config.py via pydantic-settings; nothing else touches os.environ.

# --- Runtime -----------------------------------------------------------------
JARVIS_MODE=cloud                 # cloud | local
JARVIS_WAKE_WORD=hey jarvis
JARVIS_HOTKEY=ctrl+alt+j
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=./data            # SQLite and Chroma
JARVIS_MODELS_DIR=./models        # ONNX models from scripts/download_models.py

# --- LLM ---------------------------------------------------------------------
JARVIS_LLM_PROVIDER=anthropic     # anthropic | ollama | local (llama.cpp in process)
ANTHROPIC_API_KEY=
JARVIS_LLM_MODEL=claude-sonnet-5-5
JARVIS_VISION_MODEL=claude-sonnet-5-5
JARVIS_OLLAMA_BASE_URL=http://localhost:11434
JARVIS_OLLAMA_MODEL=qwen2.5:7b    # any Ollama model that supports tool calling

# --- Speech ------------------------------------------------------------------
JARVIS_STT_MODEL=small            # faster-whisper size: tiny|base|small|medium|large-v3
JARVIS_STT_DEVICE=auto            # auto | cpu | cuda
JARVIS_STT_COMPUTE_TYPE=auto      # auto | int8 | float16 | float32
JARVIS_TTS_VOICE=en-GB-RyanNeural # edge-tts voice id
JARVIS_LOCAL_LLM_MODEL=models/qwen2.5-0.5b-instruct-q4_k_m.gguf  # any GGUF chat model
JARVIS_LOCAL_STT_MODEL=models/ggml-tiny.bin                      # any ggml whisper model
JARVIS_LOCAL_TTS_MODEL=models/en_GB-northern_english_male-medium.onnx  # Piper voice (+ .onnx.json)

# --- Integrations (leave empty to use the stub provider) ---------------------
GOOGLE_CLIENT_SECRETS_FILE=       # OAuth client JSON for Gmail + Calendar
MS_CLIENT_ID=                     # Azure app registration for Outlook + Teams
MS_TENANT_ID=common
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Proactive ---------------------------------------------------------------
JARVIS_ROUTINES_DIR=./routines   # YAML routine files, see routines/morning.yaml
JARVIS_PROACTIVE_POLL_SECONDS=60 # how often triggers (calendar, battery...) are checked

# --- Memory ------------------------------------------------------------------
JARVIS_MEMORY_RECENT_TURNS=10    # user/assistant exchanges recalled verbatim
JARVIS_MEMORY_SEMANTIC_HITS=5    # similar past turns/notes recalled from ChromaDB

# --- Integrations (extra) ----------------------------------------------------
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback  # must match the Spotify app settings
DISCORD_GUILD_ID=                 # server to read when no channel is given

# --- Agent -------------------------------------------------------------------
JARVIS_CONFIRM_DESTRUCTIVE=true   # false = trusted mode: never ask before side-effecting tools
JARVIS_SHELL_ALLOWLIST=git,ls,dir,cat,type,python,uv,pip,pytest,ruff,mypy,npm,npx,node,cargo,where,which
JARVIS_SHELL_TIMEOUT_SECONDS=30
JARVIS_SHELL_WORKING_ROOT=        # commands may only run under this directory; empty = your home

# --- Web and documents -------------------------------------------------------
JARVIS_DOCUMENT_ROOTS=            # os.pathsep-separated (";" on Windows); default ~/Documents;~/Desktop;~/Downloads
JARVIS_WEB_USER_AGENT=            # default identifies Jarvis; override if a site needs a browser UA
BRAVE_SEARCH_API_KEY=             # optional; empty uses keyless DuckDuckGo HTML search

# --- Integration tools (step 8d) ---------------------------------------------
JARVIS_DOCUMENTS_OUTPUT_DIR=      # where draft_document writes .md/.docx; empty = ~/Documents/Jarvis

# --- Local mode (step 12b) ---------------------------------------------------
JARVIS_STT_LANGUAGE=              # ISO 639-1 code (en, de...); empty = auto-detect
JARVIS_LOCAL_STT_THREADS=0        # whisper.cpp threads; 0 = pick for this CPU
JARVIS_LOCAL_LLM_CONTEXT_SIZE=4096
JARVIS_LOCAL_LLM_THREADS=0        # llama.cpp threads; 0 = pick for this CPU
JARVIS_LOCAL_LLM_MAX_TOKENS=512
JARVIS_LOCAL_LLM_TEMPERATURE=0.4

# --- Vision (step 11) --------------------------------------------------------
JARVIS_VISION_ENABLED=true            # false = never capture or upload the screen
JARVIS_VISION_MAX_LONG_EDGE=1920      # screenshots are downscaled so the long edge fits (max 2576 useful on Claude)
JARVIS_VISION_MAX_IMAGE_BYTES=5000000 # base64 size budget per image; PNG first, then JPEG, then smaller
JARVIS_VISION_SAVE_SCREENSHOTS=true   # keep the full-resolution capture under data/screenshots
JARVIS_OLLAMA_VISION_MODEL=           # e.g. qwen2.5vl:7b; empty = screen questions unavailable with Ollama

# --- Agent loop (step 6b) ----------------------------------------------------
JARVIS_ASSISTANT_NAME=Jarvis      # what the assistant calls itself and answers to
JARVIS_PERSONA_TONE=calm, concise and dryly witty, like a capable butler
JARVIS_MAX_TOOL_ROUNDS=6          # model <-> tool round trips per request before Jarvis wraps up

# --- Voice (step 7) ----------------------------------------------------------
JARVIS_BARGE_IN_ECHO_GUARD_MS=400 # ignore speech onset this long after Jarvis starts talking (no AEC)
JARVIS_VAD_MIN_SPEECH_MS=250      # speech must last this long to count (also debounces barge-in)
JARVIS_LISTEN_TIMEOUT_SECONDS=6   # after the wake word or hotkey, give up if nobody speaks
JARVIS_MAX_UTTERANCE_SECONDS=20   # cut off (and still transcribe) longer utterances
JARVIS_MIN_TRANSCRIPT_CHARS=2     # shorter transcripts count as "didn't catch that"
JARVIS_OVERLAY_ENABLED=true       # always-on-top status panel (needs the native build)
JARVIS_TRAY_ENABLED=true          # tray icon with dashboard / overlay / mute / quit menu
JARVIS_DASHBOARD_ENABLED=true     # Tk window: state, transcript, tool calls, latency, memory
JARVIS_PROACTIVE_ENABLED=true     # battery, reminder, meeting and finished-command notices; timed routines
