# Copy to .env and fill in. Never commit .env. All keys are read by
# src/jarvis/config.py via pydantic-settings; nothing else touches os.environ.

# --- Runtime -----------------------------------------------------------------
JARVIS_MODE=cloud                 # cloud | local
JARVIS_WAKE_WORD=hey jarvis
JARVIS_HOTKEY=ctrl+alt+j
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=./data            # SQLite and Chroma
JARVIS_MODELS_DIR=./models        # ONNX models from scripts/download_models.py

# --- LLM ---------------------------------------------------------------------
JARVIS_LLM_PROVIDER=ollama        # ollama (default, free, local) | anthropic (Claude) | local (llama.cpp in process)
ANTHROPIC_API_KEY=                # only needed with JARVIS_LLM_PROVIDER=anthropic
JARVIS_LLM_MODEL=claude-sonnet-5-5
JARVIS_VISION_MODEL=claude-sonnet-5-5
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434  # "localhost" is rewritten to this: on Windows it tries IPv6 first (+2 s per connection)
JARVIS_OLLAMA_MODEL=qwen2.5:7b    # any Ollama model that supports tool calling

# --- Speech ------------------------------------------------------------------
JARVIS_STT_MODEL=                 # pin one faster-whisper model for every device; empty = per device (below)
JARVIS_STT_DEVICE=auto            # auto | cpu | cuda
JARVIS_STT_COMPUTE_TYPE=auto      # auto | int8 | float16 | float32
JARVIS_TTS_VOICE=en-GB-RyanNeural # edge-tts voice id
JARVIS_LOCAL_LLM_MODEL=models/qwen2.5-0.5b-instruct-q4_k_m.gguf  # any GGUF chat model
JARVIS_LOCAL_STT_MODEL=models/ggml-tiny.bin                      # any ggml whisper model
JARVIS_LOCAL_TTS_MODEL=models/en_GB-northern_english_male-medium.onnx  # Piper voice (+ .onnx.json)

# --- Voice latency (ADR-0030; measured numbers in README "Performance") --------
JARVIS_STT_LANGUAGE=              # set it (sv, en...) if you speak one language: auto-detect costs a second encoder pass
JARVIS_STT_BEAM_SIZE=1            # 1 = greedy; matched beam 5 on short commands, faster
JARVIS_VAD_SILENCE_END_MS=700     # silence that ends an utterance; 500 answers sooner but cuts off mid-sentence pauses
JARVIS_OLLAMA_KEEP_ALIVE=30m      # keep the chat model loaded between turns; -1 = as long as Ollama runs
JARVIS_OLLAMA_NUM_CTX=            # fixed context window per request (e.g. 8192); empty = the server's default
JARVIS_LLM_WARM_UP=true           # load the LLM at startup instead of on the first request
JARVIS_TTS_PROVIDER=auto          # auto | edge | piper (local voice in cloud mode, no network round trip)

# --- Integrations (empty = not configured; connect: README "Connect your accounts")
GOOGLE_CLIENT_SECRETS_FILE=       # Desktop-app OAuth client JSON, e.g. data\google_client.json
MS_CLIENT_ID=                     # Entra app registration for Outlook (+ Teams); see README
MS_TENANT_ID=common
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Proactive ---------------------------------------------------------------
JARVIS_ROUTINES_DIR=./routines   # YAML routine files, see routines/morning.yaml
JARVIS_PROACTIVE_POLL_SECONDS=60 # how often triggers (calendar, battery...) are checked

# --- Memory ------------------------------------------------------------------
JARVIS_MEMORY_RECENT_TURNS=10    # user/assistant exchanges recalled verbatim
JARVIS_MEMORY_SEMANTIC_HITS=5    # similar past turns/notes recalled from ChromaDB

# --- Integrations (extra) ----------------------------------------------------
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback  # must match the Spotify app settings
DISCORD_GUILD_ID=                 # server to read when no channel is given
JARVIS_TEAMS_ENABLED=false        # work/school accounts only; then connect with --teams

# --- Agent -------------------------------------------------------------------
JARVIS_CONFIRM_DESTRUCTIVE=true   # false = trusted mode: never ask before side-effecting tools
JARVIS_SHELL_ALLOWLIST=git,ls,dir,cat,type,python,uv,pip,pytest,ruff,mypy,npm,npx,node,cargo,where,which
JARVIS_SHELL_TIMEOUT_SECONDS=30
JARVIS_SHELL_WORKING_ROOT=        # commands may only run under this directory; empty = your home

# --- Web and documents -------------------------------------------------------
JARVIS_DOCUMENT_ROOTS=            # os.pathsep-separated (";" on Windows); default ~/Documents;~/Desktop;~/Downloads
JARVIS_WEB_USER_AGENT=            # default identifies Jarvis; override if a site needs a browser UA
BRAVE_SEARCH_API_KEY=             # optional; empty uses keyless DuckDuckGo HTML search

# --- Integration tools -------------------------------------------------------
JARVIS_DOCUMENTS_OUTPUT_DIR=      # where draft_document writes .md/.docx; empty = ~/Documents/Jarvis

# --- Local mode --------------------------------------------------------------
JARVIS_LOCAL_STT_THREADS=0        # whisper.cpp threads; 0 = pick for this CPU
JARVIS_LOCAL_LLM_CONTEXT_SIZE=4096
JARVIS_LOCAL_LLM_THREADS=0        # llama.cpp threads; 0 = pick for this CPU
JARVIS_LOCAL_LLM_MAX_TOKENS=512
JARVIS_LOCAL_LLM_TEMPERATURE=0.4

# --- Vision ------------------------------------------------------------------
JARVIS_VISION_ENABLED=true            # false = never capture or upload the screen
JARVIS_VISION_MAX_LONG_EDGE=1920      # screenshots are downscaled so the long edge fits (max 2576 useful on Claude)
JARVIS_VISION_MAX_IMAGE_BYTES=5000000 # base64 size budget per image; PNG first, then JPEG, then smaller
JARVIS_VISION_SAVE_SCREENSHOTS=true   # keep the full-resolution capture under data/screenshots
JARVIS_OLLAMA_VISION_MODEL=           # e.g. qwen2.5vl:7b; empty = screen questions unavailable with Ollama

# --- Agent loop --------------------------------------------------------------
JARVIS_ASSISTANT_NAME=Jarvis      # what the assistant calls itself and answers to
JARVIS_PERSONA_TONE=calm, concise and dryly witty, like a capable butler
JARVIS_MAX_TOOL_ROUNDS=6          # model <-> tool round trips per request before Jarvis wraps up

# --- Voice -------------------------------------------------------------------
JARVIS_BARGE_IN_ECHO_GUARD_MS=400 # ignore speech onset this long after Jarvis starts talking (no AEC)
JARVIS_VAD_MIN_SPEECH_MS=250      # speech must last this long to count (also debounces barge-in)
JARVIS_LISTEN_TIMEOUT_SECONDS=6   # after the wake word or hotkey, give up if nobody speaks
JARVIS_MAX_UTTERANCE_SECONDS=20   # cut off (and still transcribe) longer utterances
JARVIS_MIN_TRANSCRIPT_CHARS=2     # shorter transcripts count as "didn't catch that"
JARVIS_OVERLAY_ENABLED=true       # always-on-top status panel (needs the native build)
JARVIS_TRAY_ENABLED=true          # tray icon with dashboard / overlay / mute / quit menu
JARVIS_DASHBOARD_ENABLED=true     # Tk window: state, transcript, tool calls, latency, memory
JARVIS_PROACTIVE_ENABLED=true     # battery, reminder, meeting and finished-command notices; timed routines

# --- Agent hardening (ADR-0020) ----------------------------------------------
JARVIS_MAX_TOOLS_PER_TURN=        # tool schemas per request; empty = 12 for ollama/local, all for anthropic; 0 = all
JARVIS_CORE_TOOLS=current_time,web_search  # always offered when the per-turn selection is active

# --- Desktop app (ADR-0021) --------------------------------------------------
JARVIS_DASHBOARD_START_VISIBLE=true     # open the dashboard on start; the windowless app always starts hidden
JARVIS_LOG_FILE_MAX_BYTES=1000000       # windowless app: rotate data/logs/jarvis.log at this size
JARVIS_LOG_FILE_BACKUPS=3               # rotated copies kept (jarvis.log.1 ... .3)
JARVIS_OLLAMA_AUTOSTART=true            # windowless app: start Ollama if it is not answering (llm_provider=ollama)
JARVIS_OLLAMA_START_TIMEOUT_SECONDS=20  # how long to wait for a freshly started Ollama to answer

# --- Overlay animations ------------------------------------------------------
JARVIS_OVERLAY_BOOT_ANIMATION=true  # play the ~2.5 s boot sequence when the overlay starts
JARVIS_OVERLAY_THEME=cyan           # HUD palette: cyan or amber

# Overlay richness
JARVIS_OVERLAY_INTENSITY=normal     # calm, normal or max: particle count, bloom strength and motion
JARVIS_OVERLAY_SIZE=large           # corner HUD size: compact (420x132), normal (600x216) or large (760x300)

# --- Integrations demo data --------------------------------------------------
JARVIS_DEMO_INTEGRATIONS=false   # true serves Stub* sample mail/events/chats when no account is connected

# --- Wake word -----------------------------------------------------------------
JARVIS_WAKE_WORD_THRESHOLD=0.8   # openWakeWord score for "Hey Jarvis"; raise if it wakes on other speech

# Interactive HUD
JARVIS_OVERLAY_INTERACTIVE=true    # hover controls, typing, dragging and the expanded view (ADR-0024)
JARVIS_SPEAK_REPLIES=true          # false keeps typed conversations silent (answers shown as text)
JARVIS_WAKE_WORD_ENABLED=true      # false listens for the hotkey only (like --no-wakeword)
JARVIS_OVERLAY_POSITION=           # JSON {"monitor": "\\\\.\\DISPLAY1", "x": 40, "y": 60}; empty = default corner
JARVIS_OVERLAY_EXPANDED_BOUNDS=    # same JSON plus "width"/"height"; empty = 900x640 next to the HUD
JARVIS_USER_SETTINGS_ENABLED=true  # layer data/user_settings.json (what the HUD saves) over this file

# HUD minimize
JARVIS_HUD_TOGGLE_HOTKEY=ctrl+alt+h   # minimize the HUD to its orb / restore it; empty disables; must differ from JARVIS_HOTKEY
JARVIS_HUD_AUTO_MINIMIZE_SECONDS=0    # shrink the idle HUD to the orb after this many seconds; 0 = off
JARVIS_HUD_HIDE_IN_FULLSCREEN=true    # hide the HUD and orb while a full-screen game, video or slide show is in front
JARVIS_HUD_MINIMIZED=false            # start as the orb (the HUD remembers this in data/user_settings.json)
JARVIS_HUD_ORB_POSITION=              # JSON {"monitor": "\\\\.\\DISPLAY1", "x": 12, "y": 900}; empty = dock next to the HUD

# Tool selection (multilingual)
JARVIS_TOOL_EMBEDDING_MODEL=bge-m3        # Ollama embedding model ranking tools by meaning (any language); 'none' = keywords only. Pull it: ollama pull bge-m3
JARVIS_TOOL_EMBEDDING_TIMEOUT_MS=150      # a turn waits at most this long for its embedding, then ranks tools by keywords
JARVIS_TOOL_SELECTION_KEYWORD_WEIGHT=0.4  # hybrid ranking: share of keyword overlap (ADR-0020, update)
JARVIS_TOOL_SELECTION_SEMANTIC_WEIGHT=0.6 # hybrid ranking: share of embedding similarity
JARVIS_OLLAMA_THINK=false                 # thinking models (qwen3): false = answer directly, true = reason first (slower), default = model's choice

# --- Voice robustness (ADR-0019 update) ---------------------------------------
JARVIS_BARGE_IN_MODE=auto            # auto | voice | wake_word | off: what interrupts Jarvis while it speaks
JARVIS_BARGE_IN_ECHO_RATIO=2.0       # voice mode: onset must be this many times louder than the echo; 0 = no check
JARVIS_BARGE_IN_ECHO_WINDOW_MS=300   # level history compared at a speech onset
JARVIS_SELF_WAKE_GUARD_MS=2500       # ignore the wake word this long after Jarvis says its own name
JARVIS_SPEAKING_WAKE_MARGIN=0.1      # while speaking, the wake word needs JARVIS_WAKE_WORD_THRESHOLD + this
JARVIS_STT_MODEL_GPU=large-v3-turbo  # faster-whisper on CUDA (needs `uv sync --extra gpu`)
JARVIS_STT_MODEL_CPU=small           # faster-whisper on the CPU, also the fallback from auto
JARVIS_STT_HOTWORDS=Jarvis, Discord, Gmail, Spotify  # names to prefer when unsure; empty = no bias
